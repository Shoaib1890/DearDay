{
  "expo": {
    "name": "DearDay",
    "slug": "dearday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dearday",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dearday.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.dearday.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F7F1E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "DearDay uses your photos only to add a picture for someone you care about."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1A7F5A",
          "defaultChannel": "birthday-reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F1E8",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 180
        }
      ]
    ],
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FBF8F3"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44254c7c-74c1-4e18-8684-40896c510520"
      }
    },
    "owner": "shy1890"
  }
}
